# Copy to ~/.config/whatsapp-mcp/env and make it private: chmod 600.
# systemd format: KEY=value, one per line. No "export", no shell quoting.

# Required, at least 32 characters. Generate one with: openssl rand -hex 32
# Left empty here so that a copy nobody filled in refuses to start.
WHATSAPP_MCP_TOKEN=

# Optional.
#WHATSAPP_MCP_READ_ONLY=true
# Delete archived messages from disappearing chats when their timer runs out:
#WHATSAPP_MCP_EXPIRE_DISAPPEARING=true
# Offer the tools that create, change and leave groups (hard to undo):
#WHATSAPP_MCP_ENABLE_GROUP_ADMIN=true
# Offer get_presence and set_typing (they show your account as online for a short while):
#WHATSAPP_MCP_ENABLE_PRESENCE=true
# With an allowlist set, also allow group invite links (anyone with a link can join):
#WHATSAPP_MCP_ALLOW_INVITE_LINKS=true
# With an allowlist set, also allow posting status updates (they go to your whole status audience):
#WHATSAPP_MCP_ALLOW_STATUS=true
#WHATSAPP_MCP_ALLOW_RECIPIENTS=+31612345678,120363000000000000@g.us
#WHATSAPP_MCP_LOG_LEVEL=info
# Behind a TLS reverse proxy (see "Remote access over TLS" in the README):
#WHATSAPP_MCP_PUBLIC_URL=https://wa.example.com
# Postgres instead of the SQLite file set in the unit (this overrides it):
#DATABASE_URL=postgres://user:pass@host/db
